<file path="styles/globals.css">
@import "tailwindcss";
@import "tw-animate-css";

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap");
@import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css");

/* ================= ROOT ================= */

:root {
  --background: #070b14;
  --foreground: #eef5ff;

  --card: rgba(255, 255, 255, 0.06);
  --card-foreground: #eef5ff;

  --popover: rgba(255, 255, 255, 0.08);
  --popover-foreground: #eef5ff;

  --primary: #eef5ff;
  --primary-foreground: #070b14;

  --secondary: rgba(255, 255, 255, 0.08);
  --secondary-foreground: #eef5ff;

  --muted: rgba(255, 255, 255, 0.05);
  --muted-foreground: #9aa6c2;

  --accent: rgba(255, 255, 255, 0.08);
  --accent-foreground: #eef5ff;

  --destructive: #ef4444;
  --destructive-foreground: #ffffff;

  --border: rgba(255, 255, 255, 0.08);
  --input: rgba(255, 255, 255, 0.06);
  --ring: rgba(255, 255, 255, 0.14);

  --radius-card: 20px;
  --radius-input: 18px;
  --radius-small: 14px;
  --radius-pill: 999px;

  --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.22);

  --font-sans:
    "Inter", "Pretendard", "Noto Sans KR", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ================= RESET ================= */

* {
  box-sizing: border-box;
  text-shadow: none;
}

*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
}

html {
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, rgba(126, 168, 255, 0.12), transparent 35%),
    linear-gradient(180deg, #070b14 0%, #070b14 100%);
  color: var(--foreground);
  font-family: var(--font-sans);
  font-weight: 400;
  letter-spacing: -0.01em;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

/* ================= TYPOGRAPHY ================= */

h1,
h2,
h3,
h4,
h5,
h6,
strong,
b {
  font-weight: 500;
  letter-spacing: -0.01em;
}

p {
  margin: 0;
}

/* ================= FORM ================= */

button,
input,
textarea,
select {
  font: inherit;
  outline: none;
}

button {
  -webkit-tap-highlight-color: transparent;
}

/* ================= SELECTION ================= */

::selection {
  background: rgba(126, 168, 255, 0.2);
  color: #ffffff;
}

/* ================= SCROLL ================= */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

/* ================= LAYOUT ================= */

.app-shell {
  min-height: 100dvh;
  max-width: 430px;
  margin: 0 auto;
  position: relative;
  display: flex;
  flex-direction: column;
}

.app-main {
  flex: 1;
  padding: 14px 14px 110px;
  overflow-y: auto;
}

/* ================= CARD ================= */

.card {
  border-radius: var(--radius-card);
  background: var(--card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(16px);
}

/* ================= INPUT ================= */

input,
textarea,
select {
  width: 100%;
  min-width: 0;

  border-radius: var(--radius-input);
  border: 1px solid rgba(255, 255, 255, 0.08);

  background: rgba(255, 255, 255, 0.04);

  color: var(--foreground);

  transition:
    border-color 0.18s ease,
    background-color 0.18s ease,
    transform 0.18s ease;
}

input,
select {
  height: 56px;
  padding: 0 16px;
  font-size: 15px;
}

textarea {
  padding: 14px 16px;
  min-height: 120px;
  resize: vertical;
}

input::placeholder,
textarea::placeholder {
  color: rgba(255, 255, 255, 0.34);
}

input:focus,
textarea:focus,
select:focus {
  border-color: rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.06);
}

/* ================= FORM GRID ================= */

.form-grid-two,
.form-grid.two,
.date-grid,
.date-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
}

.form-grid-two > *,
.form-grid.two > *,
.date-grid > *,
.date-row > * {
  min-width: 0;
}

.form-field {
  min-width: 0;
}

.form-field input,
.form-field textarea,
.form-field select {
  width: 100%;
  min-width: 0;
}

/* ================= MOBILE ================= */

@media (max-width: 390px) {
  .form-grid-two,
  .form-grid.two,
  .date-grid,
  .date-row {
    grid-template-columns: 1fr;
  }
}

/* ================= BUTTON ================= */

button {
  border: 0;
  cursor: pointer;
}

.primary-btn {
  height: 54px;

  border-radius: 18px;

  background: rgba(255, 255, 255, 0.1);

  color: #ffffff;

  font-size: 15px;
  font-weight: 600;

  transition:
    background 0.18s ease,
    transform 0.18s ease;
}

.primary-btn:hover {
  background: rgba(255, 255, 255, 0.14);
}

/* ================= FAB ================= */

.fab {
  position: fixed;

  right: max(20px, calc((100vw - 430px) / 2 + 20px));
  bottom: 88px;

  width: 58px;
  height: 58px;

  border-radius: 999px;

  background: rgba(255, 255, 255, 0.08);

  color: #ffffff;

  font-size: 30px;
  font-weight: 200;

  backdrop-filter: blur(20px);

  border: 1px solid rgba(255, 255, 255, 0.06);

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);

  z-index: 40;
}

/* ================= SECTION ================= */

.section-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ================= EMPTY ================= */

.empty-card {
  padding: 18px;
}

.empty-card p {
  color: var(--muted-foreground);
  font-size: 13px;
}
</file>


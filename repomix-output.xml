  font-size: 15px;
  font-weight: 600;
}

.more-group__desc {
  margin: 4px 0 0;
  font-size: 12px;
  color: var(--text-soft);
}

.more-group__count {
  min-width: 24px;
  height: 24px;
  padding: 0 8px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  font-size: 12px;
  color: var(--text-soft);
}

.empty-inline {
  font-size: 13px;
  color: var(--text-soft);
}

.bottom-nav {
  position: fixed;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: min(430px, 100%);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: rgba(10, 14, 28, 0.88);
  backdrop-filter: blur(18px);
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  z-index: 30;
}

.bottom-nav__item {
  height: 52px;
  border: 0;
  border-radius: 16px;
  background: transparent;
  color: var(--text-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.bottom-nav__item span {
  font-size: 11px;
}

.bottom-nav__item.is-active {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text);
}

.fab {
  position: fixed;
  right: max(20px, calc((100vw - 430px) / 2 + 20px));
  bottom: 88px;
  width: 56px;
  height: 56px;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 28px;
  line-height: 1;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(18px);
  z-index: 35;
}

.calendar-view {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.calendar-shell {
  padding: 14px;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(14px);
}

.calendar-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}

.calendar-topbar__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.calendar-topbar__eyebrow {
  margin: 0 0 4px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-soft);
}

.calendar-topbar__title {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
}

.calendar-today-btn {
  height: 34px;
  padding: 0 12px;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--text);
  font-size: 12px;
}

.calendar-shell .fc {
  --fc-border-color: rgba(255, 255, 255, 0.06);
  --fc-page-bg-color: transparent;
  --fc-neutral-bg-color: transparent;
  --fc-list-event-hover-bg-color: rgba(255, 255, 255, 0.04);
  color: var(--text);
}

.calendar-shell .fc-theme-standard td,
.calendar-shell .fc-theme-standard th,
.calendar-shell .fc-scrollgrid {
  border-color: rgba(255, 255, 255, 0.05) !important;
}

.calendar-shell .fc .fc-toolbar {
  margin-bottom: 12px !important;
  align-items: center;
}

.calendar-shell .fc .fc-toolbar-title {
  font-size: 18px !important;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.calendar-shell .fc .fc-button {
  height: 34px;
  padding: 0 12px !important;
  border-radius: 999px !important;
  border: 0 !important;
  background: rgba(255, 255, 255, 0.08) !important;
  color: var(--text) !important;
  box-shadow: none !important;
}

.calendar-shell .fc .fc-button:hover,
.calendar-shell .fc .fc-button:focus,
.calendar-shell .fc .fc-button:active {
  background: rgba(255, 255, 255, 0.12) !important;
  box-shadow: none !important;
}

.calendar-shell .fc .fc-button-primary:not(:disabled).fc-button-active {
  background: rgba(255, 255, 255, 0.16) !important;
}

.calendar-shell .fc .fc-col-header-cell {
  padding: 8px 0;
  background: transparent;
}

.calendar-shell .fc .fc-col-header-cell-cushion {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-soft);
  text-decoration: none !important;
}

.calendar-shell .fc .fc-daygrid-day-frame {
  min-height: 62px;
  padding: 4px;
}

.calendar-shell .fc .fc-daygrid-day-top {
  justify-content: center;
  padding-top: 2px;
}

.calendar-shell .fc .fc-daygrid-day-number {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: var(--text);
  text-decoration: none !important;
}

.calendar-shell .fc .fc-day-today {
  background: transparent !important;
}

.calendar-shell .fc .fc-day-today .fc-daygrid-day-number {
  background: rgba(255, 255, 255, 0.14);
  font-weight: 700;
}

.calendar-shell .fc .fc-day-other .fc-daygrid-day-number {
  opacity: 0.28;
}

.calendar-shell .fc .fc-daygrid-day-events {
  margin-top: 4px;
}

.calendar-shell .fc .fc-daygrid-event {
  margin: 2px 4px 0 !important;
  border: 0 !important;
  border-radius: 999px !important;
  background: rgba(183, 199, 255, 0.22) !important;
  color: #eef2ff !important;
  padding: 1px 8px !important;
}

.calendar-shell .fc .fc-event-title {
  font-size: 11px;
  font-weight: 600;
}

.calendar-shell .fc .fc-daygrid-more-link {
  font-size: 11px;
  color: var(--text-soft);
  text-decoration: none !important;
}

.calendar-shell .fc .fc-scrollgrid-section-header > *,
.calendar-shell .fc .fc-scrollgrid-section-body > * {
  background: transparent !important;
}

.calendar-shell .fc .fc-view-harness {
  min-height: auto !important;
}

.calendar-shell .fc .fc-daygrid-body-natural .fc-daygrid-day-events {
  margin-bottom: 2px;
}

.calendar-selected {
  padding: 14px;
}

.calendar-selected__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.calendar-selected__eyebrow {
  margin: 0 0 4px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-soft);
}

.calendar-selected__title {
  margin: 0;
  font-size: 17px;
  line-height: 1.35;
  font-weight: 700;
}

.calendar-selected__count {
  min-width: 24px;
  height: 24px;
  padding: 0 8px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  font-size: 12px;
  color: var(--text-soft);
}

.calendar-selected .section-stack {
  gap: 12px;
}

.calendar-empty {
  padding: 16px;
}

.calendar-row {
  padding: 12px 12px 11px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(255, 255, 255, 0.07);
  display: flex;
  flex-direction: column;
  gap: 10px;
  cursor: pointer;
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    transform 0.18s ease;
}

.calendar-row:hover {
  background: rgba(255, 255, 255, 0.065);
  border-color: rgba(255, 255, 255, 0.1);
}

.calendar-row__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.calendar-row__meta {
  display: flex;
  align-items: center;
  gap: 8px 10px;
  flex-wrap: wrap;
  min-width: 0;
}

.calendar-row__type {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 0 9px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  font-size: 11px;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}

.calendar-row__date {
  font-size: 11px;
  color: var(--text-soft);
  line-height: 1.45;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.calendar-row__check {
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.34);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
}

.calendar-row__body {
  min-width: 0;
}

.calendar-row__title-wrap {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
}

.calendar-row__assignee {
  width: 4px;
  min-width: 4px;
  height: 36px;
  border-radius: 999px;
  opacity: 0.95;
}

.calendar-row__text-block {
  flex: 1;
  min-width: 0;
}

.calendar-row__title {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
  word-break: break-word;
  overflow-wrap: anywhere;
}

.calendar-row__title.is-done {
  color: rgba(255, 255, 255, 0.36);
  text-decoration: line-through;
}

.calendar-row__sub {
  margin-top: 5px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
}

.calendar-row__sub-item {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: var(--text-soft);
  min-width: 0;
}

.calendar-event-chip {
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.calendar-event-chip__text {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ================= WEATHER BTN ================= */

.calendar-weather-btn {
  height: 34px;
  padding: 0 12px;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
  color: var(--text-soft);
  font-size: 11px;
  white-space: nowrap;
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ================= CALENDAR TABS ================= */

.calendar-tabs {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 999px;
  padding: 3px;
}

.calendar-tab {
  flex: 1;
  height: 30px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--text-soft);
  font-size: 12px;
  font-weight: 500;
  transition:
    background 0.18s ease,
    color 0.18s ease;
}

.calendar-tab.is-active {
  background: rgba(255, 255, 255, 0.12);
  color: var(--text);
  font-weight: 600;
}

/* ================= DAY CELL WEATHER ================= */

.fc-daycell-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  width: 100%;
}

.fc-daycell-num {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: var(--text);
}

.fc-day-today .fc-daycell-num {
  background: rgba(255, 255, 255, 0.14);
  font-weight: 700;
}

.fc-day-other .fc-daycell-num {
  opacity: 0.28;
}

.fc-daycell-weather {
  font-size: 10px;
  line-height: 1;
}

/* ================= SELECTED WEATHER ================= */

.calendar-selected__weather {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--text-soft);
}

/* ================= WEEK VIEW ================= */

.calendar-shell .fc .fc-timegrid-slot {
  height: 40px;
}

.calendar-shell .fc .fc-timegrid-slot-label {
  font-size: 10px;
  color: var(--text-soft);
  vertical-align: top;
  padding-top: 2px;
}

.calendar-shell .fc .fc-timegrid-col-events {
  margin: 0 2px;
}

.calendar-shell .fc .fc-timegrid-event {
  border-radius: 8px !important;
  border: 0 !important;
  background: rgba(183, 199, 255, 0.28) !important;
  color: #eef2ff !important;
  font-size: 11px;
}

/* ================= LOCATION MODAL ================= */

.location-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(6px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.location-modal {
  width: 100%;
  max-width: 340px;
  background: #0f1826;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.location-modal__title {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.location-modal__input {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  color: var(--text);
  font-size: 14px;
}

.location-modal__error {
  margin: 0;
  font-size: 12px;
  color: #f87171;
}

.location-modal__actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}

.location-modal__cancel {
  height: 38px;
  padding: 0 16px;
  border-radius: 999px;
  border: 0;
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-soft);
  font-size: 13px;
}

.location-modal__save {
  height: 38px;
  padding: 0 18px;
  border-radius: 999px;
  border: 0;
  background: rgba(255, 255, 255, 0.14);
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
}

.location-modal__save:disabled {
  opacity: 0.5;
}
/* ================= FORM FIX ================= */

.form-grid-two,
.form-grid.two,
.date-grid,
.date-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
}

.form-grid-two > *,
.form-grid.two > *,
.date-grid > *,
.date-row > * {
  min-width: 0;
}

.form-field {
  min-width: 0;
}

.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

@media (max-width: 390px) {
  .form-grid-two,
  .form-grid.two,
  .date-grid,
  .date-row {
    grid-template-columns: 1fr;
  }
}
